# Copier en .env (ignoré par git) pour le local, ou définir dans Vercel (Settings > Environment Variables).
# Ne jamais mettre de vraie valeur ici.

# Assistant IA du devis (serveur). "true" pour activer, toute autre valeur = désactivé.
IA_ACTIVE=false
# Clé OVH AI Endpoints (serveur uniquement, jamais exposée au navigateur).
OVH_AI_ENDPOINTS_ACCESS_TOKEN=

# Dictée vocale dans « Nouveau devis » (navigateur). Désactivée par défaut.
VITE_DICTEE_ACTIVE=false
# Assistant simulé (chatbot sans IA). Ignoré en production. Désactivé par défaut.
VITE_CHATBOT_SIMULE=false
